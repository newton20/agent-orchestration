{
  "_comment": "Quoted \"${CLAUDE_PLUGIN_ROOT}\" is load-bearing under Git Bash — see hooks/README.md and spikes/launcher-compat-findings.md",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\"",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-observation.cmd\" SessionStart",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-observation.cmd\" UserPromptSubmit",
            "async": false
          }
        ]
      }
    ]
  }
}
